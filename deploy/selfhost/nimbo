#!/usr/bin/env python3
"""Manage only the Nimbo installation beside this executable."""
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import urllib.request

ROOT = Path(__file__).resolve().parent


def compose(*args, capture=False):
    return subprocess.run(['docker', 'compose', '--project-directory', str(ROOT),
        '-f', str(ROOT / 'compose.json'), *args], check=True,
        stdout=subprocess.PIPE if capture else None, text=True)


def ready():
    path = ROOT / 'data/workspace.json'
    if not path.is_file() or not json.loads(path.read_text()).get('invitationsReady'):
        raise ValueError('Workspace is not initialized. Run nimbo install first.')


def healthy():
    settings = json.loads((ROOT / 'installation.json').read_text())
    for _ in range(30):
        try:
            with urllib.request.urlopen(f'http://127.0.0.1:{settings["apiPort"]}/healthz', timeout=2) as r:
                if json.load(r).get('status') == 'ok':
                    print('Nimbo API is healthy: ' + settings['origin'])
                    return
        except (OSError, ValueError):
            pass
        time.sleep(1)
    raise ValueError('API health check failed. Inspect nimbo logs; data is preserved.')


def main():
    command = sys.argv[1] if len(sys.argv) == 2 else 'help'
    if command == 'help':
        print('Nimbo — управление этой установкой\n'
              '  install     собрать, проверить конфиги, создать пустую базу и запустить\n'
              '  status      состояние контейнеров\n'
              '  logs        последние 100 строк журналов\n'
              '  start       запустить существующую установку\n'
              '  stop        остановить эту установку, сохранив данные\n'
              '  owner-code  новый одноразовый код владельца на 30 минут\n'
              '  help        эта справка')
        return
    if command not in ('install', 'status', 'logs', 'start', 'stop', 'owner-code'):
        raise ValueError('Unknown command. Run nimbo help.')
    if os.geteuid() != 0:
        raise ValueError('Run with sudo.')
    with (ROOT / '.control.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if command == 'install':
            if (ROOT / 'data/workspace.json').exists():
                raise ValueError('Workspace already exists. Use start; install never replaces data.')
            compose('config', '--quiet')
            compose('build', 'nimbo')
            compose('pull', 'livekit', 'caddy')
            compose('run', '--rm', '--no-deps', 'caddy', 'validate', '--config', '/etc/caddy/caddy.json')
            compose('run', '--rm', '--no-deps', 'nimbo', 'init', '--offline')
            ready()
            compose('up', '-d')
            healthy()
            print('Enrollment is closed. When ready, run nimbo owner-code.')
        elif command == 'start':
            ready()
            compose('up', '-d')
            healthy()
        elif command == 'stop':
            compose('stop')
        elif command == 'status':
            compose('ps', '-a')
        elif command == 'logs':
            compose('logs', '--tail', '100')
        elif command == 'owner-code':
            ready()
            running = bool(compose('ps', '--status', 'running', '-q', 'nimbo', capture=True).stdout.strip())
            if running:
                compose('stop', 'nimbo')
            try:
                compose('run', '--rm', '--no-deps', 'nimbo', 'owner-code', '--offline')
            finally:
                if running:
                    compose('up', '-d', '--no-deps', 'nimbo')


if __name__ == '__main__':
    try:
        main()
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        sys.exit(f'Nimbo: {error}')
