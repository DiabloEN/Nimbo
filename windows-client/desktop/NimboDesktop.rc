#include <winver.h>
#include "version.h"
1 ICON "nimbo.ico"
VS_VERSION_INFO VERSIONINFO
FILEVERSION NIMBO_DESKTOP_FILEVERSION
PRODUCTVERSION NIMBO_DESKTOP_FILEVERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Nimbo\0"
            VALUE "ProductName", "Nimbo\0"
            VALUE "CompanyName", "Nimbo contributors\0"
            VALUE "FileVersion", NIMBO_DESKTOP_VERSION
            VALUE "ProductVersion", NIMBO_DESKTOP_VERSION
            VALUE "OriginalFilename", "NimboDesktop.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
