{
  "name": "nimbo-test-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" index.html tsconfig.json vite.config.ts \"../scripts/*.mjs\" \"../deploy/**/*.html\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" index.html tsconfig.json vite.config.ts \"../scripts/*.mjs\" \"../deploy/**/*.html\""
  },
  "dependencies": {
    "@livekit/track-processors": "0.8.2",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "livekit-client": "2.23.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
